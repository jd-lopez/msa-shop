---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";

import mecanic from "../assets/mecanic.jpg";
import air from "../assets/air-con.jpg";
import electrical from "../assets/electrical.jpg";
import preventive from "../assets/back.jpg";
import accessories from "../assets/computerized.jpg";

interface Props {
  showCatalogLink?: boolean;
}

const { showCatalogLink = true } = Astro.props;

const services = [
  {
    slug: "mecanica-general",
    number: "01",
    eyebrow: "Motor y tren motriz",
    img: mecanic,
    title: "Mecánica general",
    description:
      "Atendemos ruidos, vibraciones, pérdida de potencia y otras señales que no conviene dejar para después.",
    details: ["Frenos y suspensión", "Motor y transmisión", "Fugas y recalentamiento"],
    imagePosition: "object-center",
  },
  {
    slug: "electricidad-automotriz",
    number: "02",
    eyebrow: "Sistema eléctrico",
    img: electrical,
    title: "Electricidad automotriz",
    description:
      "Revisamos fallas de arranque, luces de advertencia y consumos eléctricos antes de cambiar piezas.",
    details: ["Batería y alternador", "Arranque e iluminación", "Diagnóstico de fallas"],
    imagePosition: "object-center",
  },
  {
    slug: "aire-acondicionado",
    number: "03",
    eyebrow: "Climatización",
    img: air,
    title: "Aire acondicionado",
    description:
      "Evaluamos el enfriamiento y los componentes del sistema para encontrar la causa de un aire débil o irregular.",
    details: ["Revisión de presión", "Detección de fugas", "Limpieza y funcionamiento"],
    imagePosition: "object-center",
  },
  {
    slug: "mantenimiento-preventivo",
    number: "04",
    eyebrow: "Cuidado programado",
    img: preventive,
    title: "Mantenimiento preventivo",
    description:
      "Organizamos la revisión según el kilometraje y el uso del vehículo para reducir averías inesperadas.",
    details: ["Aceite y filtros", "Fluidos y niveles", "Inspección de desgaste"],
    imagePosition: "object-[center_58%]",
  },
  {
    slug: "instalacion-accesorios",
    number: "05",
    eyebrow: "Equipamiento del vehículo",
    img: accessories,
    title: "Instalación de accesorios",
    description:
      "Instalamos el accesorio que traigas o que consultes con nosotros. Actualmente nos enfocamos en la instalación y no contamos con un catálogo amplio de accesorios en venta.",
    details: [
      "Revisión de compatibilidad",
      "Conexión y montaje",
      "Prueba de funcionamiento",
    ],
    imagePosition: "object-center",
  },
];
---

<section
  id="servicios"
  class="scroll-mt-20 border-y border-slate-200 bg-[#f5f6f7] px-4 py-16 text-slate-900 dark:border-slate-800 dark:bg-[#0a0f17] dark:text-slate-100 sm:px-6 lg:px-8 lg:py-20"
  aria-labelledby="services-title"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="grid gap-8 border-b border-slate-300 pb-8 dark:border-slate-700 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,28rem)] lg:items-end"
    >
      <div>
        <p
          class="mb-3 text-xs font-bold tracking-[0.16em] text-blue-700 uppercase dark:text-blue-300"
        >
          Servicios de taller
        </p>
        <h2
          id="services-title"
          class="max-w-3xl text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl"
        >
          Revisamos el problema antes de recomendar el trabajo.
        </h2>
      </div>

      <div class="flex flex-col items-start gap-5 lg:items-end">
        <p class="max-w-md leading-7 text-slate-600 dark:text-slate-300">
          Cuéntanos qué notas al conducir. Empezamos por identificar la causa y
          te explicamos qué necesita atención ahora y qué puede esperar.
        </p>
        {
          showCatalogLink && (
            <a
              href="/servicios"
              class="group inline-flex items-center gap-2 border-b border-blue-700 pb-1 text-sm font-bold text-blue-700 transition-colors hover:border-blue-500 hover:text-blue-500 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-4 focus-visible:outline-none dark:border-blue-300 dark:text-blue-300 dark:hover:border-blue-200 dark:hover:text-blue-200 dark:focus-visible:ring-offset-[#0a0f17]"
            >
              Ver catálogo completo
              <ArrowRight
                aria-hidden="true"
                class="size-4 transition-transform duration-200 group-hover:translate-x-1"
                stroke-width={2}
              />
            </a>
          )
        }
      </div>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {
        services.map((service) => (
          <article
            id={service.slug}
            class={`group scroll-mt-24 overflow-hidden rounded-xl border border-slate-300 bg-white shadow-[0_8px_24px_rgba(15,23,42,0.06)] transition-[border-color,box-shadow] duration-300 hover:border-slate-400 hover:shadow-[0_12px_30px_rgba(15,23,42,0.09)] dark:border-slate-700 dark:bg-slate-900 dark:shadow-[0_10px_28px_rgba(0,0,0,0.22)] dark:hover:border-slate-600 dark:hover:shadow-[0_14px_34px_rgba(0,0,0,0.3)] sm:grid sm:grid-cols-[minmax(13rem,0.82fr)_minmax(0,1.18fr)] ${service.slug === "instalacion-accesorios" ? "lg:col-span-2 lg:grid-cols-[minmax(13rem,0.41fr)_minmax(0,1.59fr)]" : ""}`}
          >
            <div class="relative min-h-56 overflow-hidden border-b border-slate-200 sm:min-h-full sm:border-r sm:border-b-0 dark:border-slate-700">
              <Image
                src={service.img}
                alt={`${service.title} en Multiservicio Amador`}
                width={720}
                layout="constrained"
                sizes="(min-width: 1024px) 20vw, (min-width: 640px) 38vw, 100vw"
                format="webp"
                quality={72}
                loading="lazy"
                class={`absolute inset-0 h-full w-full object-cover ${service.imagePosition} transition-transform duration-500 ease-out group-hover:scale-[1.025] motion-reduce:transition-none motion-reduce:group-hover:scale-100 dark:brightness-[0.76] dark:contrast-[1.05] dark:saturate-[0.9]`}
              />
              <span
                class="absolute top-4 left-4 grid size-10 place-items-center rounded-md border border-white/35 bg-slate-950/75 font-mono text-xs font-bold tracking-widest text-white backdrop-blur-sm"
                aria-hidden="true"
              >
                {service.number}
              </span>
            </div>

            <div class="flex min-h-80 flex-col p-5 sm:p-6">
              <p
                class="text-[0.68rem] font-bold tracking-[0.14em] text-slate-500 uppercase dark:text-slate-400"
              >
                {service.eyebrow}
              </p>
              <h3 class="mt-2 text-xl font-extrabold tracking-tight sm:text-2xl">
                {service.title}
              </h3>
              <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">
                {service.description}
              </p>

              <ul
                class="mt-5 grid gap-2 border-t border-slate-200 pt-5 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-300"
                aria-label={`Trabajos de ${service.title}`}
              >
                {service.details.map((detail) => (
                  <li class="flex items-center gap-3">
                    <span
                      aria-hidden="true"
                      class="h-px w-4 shrink-0 bg-blue-600 dark:bg-blue-400"
                    />
                    {detail}
                  </li>
                ))}
              </ul>

              <a
                href="/#contacto"
                class="group/link mt-auto inline-flex w-fit items-center gap-2 pt-6 text-sm font-bold text-blue-700 transition-colors hover:text-blue-500 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-4 focus-visible:outline-none dark:text-blue-300 dark:hover:text-blue-200 dark:focus-visible:ring-offset-slate-900"
                aria-label={`Consultar sobre ${service.title}`}
              >
                Consultar este servicio
                <ArrowRight
                  aria-hidden="true"
                  class="size-4 transition-transform duration-200 group-hover/link:translate-x-1"
                  stroke-width={2}
                />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-slate-300 pt-6 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>¿No ves aquí la falla que presenta tu vehículo?</p>
      <a
        href="/#contacto"
        class="font-bold text-slate-900 underline decoration-slate-400 underline-offset-4 transition-colors hover:text-blue-700 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-4 focus-visible:outline-none dark:text-slate-100 dark:hover:text-blue-300 dark:focus-visible:ring-offset-[#0a0f17]"
      >
        Descríbenos el problema y te orientamos.
      </a>
    </div>
  </div>
</section>
