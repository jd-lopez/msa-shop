---
import { MessageCircle } from "@lucide/astro";

const whatsappNumber = "50582864467";
const maximumVehicleYear = new Date().getFullYear() + 1;
const serviceOptions = [
  { value: "mecanica-general", label: "Mecánica general" },
  { value: "electricidad-automotriz", label: "Electricidad automotriz" },
  { value: "aire-acondicionado", label: "Aire acondicionado" },
  { value: "mantenimiento-preventivo", label: "Mantenimiento preventivo" },
  { value: "instalacion-accesorios", label: "Instalación de accesorios" },
  { value: "otro", label: "Otro servicio / diagnóstico" },
];
---

<form
  id="whatsapp-contact-form"
  data-whatsapp-number={whatsappNumber}
  class="rounded-xl border border-white/25 bg-white p-5 text-slate-900 shadow-[0_18px_45px_rgba(3,20,55,0.22)] sm:p-7 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:shadow-[0_20px_48px_rgba(0,0,0,0.3)]"
>
  <div class="border-b border-slate-200 pb-5 dark:border-slate-700">
    <h3 class="text-xl font-extrabold tracking-tight sm:text-2xl">
      Datos para la consulta
    </h3>
    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
      Mostraremos únicamente las preguntas necesarias para el servicio que
      elijas.
    </p>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-bold sm:col-span-2">
      Nombre completo
      <input
        name="name"
        type="text"
        autocomplete="name"
        minlength="2"
        required
        placeholder="Tu nombre"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold sm:col-span-2">
      Teléfono
      <input
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        minlength="8"
        required
        placeholder="Ej. 8888 8888"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold sm:col-span-2">
      Servicio que buscas
      <select
        id="requested-service"
        name="service"
        required
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      >
        <option value="" selected disabled>Selecciona un servicio</option>
        {
          serviceOptions.map((service) => (
            <option value={service.value}>{service.label}</option>
          ))
        }
      </select>
    </label>

    <label class="grid gap-2 text-sm font-bold">
      Marca
      <input
        name="brand"
        type="text"
        required
        placeholder="Ej. Toyota"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold">
      Modelo
      <input
        name="model"
        type="text"
        required
        placeholder="Ej. Corolla"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold sm:col-span-2">
      Año
      <input
        name="year"
        type="number"
        inputmode="numeric"
        min="1950"
        max={maximumVehicleYear}
        required
        placeholder="Ej. 2018"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>
  </div>

  <div
    id="service-specific-fields"
    class="mt-6 grid gap-5 border-t border-slate-200 pt-6 dark:border-slate-700"
    aria-live="polite"
  >
    <label
      id="mileage-field"
      class="grid gap-2 text-sm font-bold"
      hidden
    >
      <span id="mileage-label">Kilometraje</span>
      <span class="relative">
        <input
          id="vehicle-mileage"
          name="mileage"
          type="number"
          inputmode="numeric"
          min="0"
          step="1"
          disabled
          placeholder="Ej. 85000"
          class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 pr-12 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
        />
        <span
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-xs font-semibold text-slate-500 dark:text-slate-400"
        >
          km
        </span>
      </span>
    </label>

    <label
      id="service-details-field"
      class="grid gap-2 text-sm font-bold"
      hidden
    >
      <span id="service-details-label">Detalles del servicio</span>
      <textarea
        id="service-details"
        name="details"
        rows="4"
        minlength="4"
        disabled
        class="resize-y rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      ></textarea>
    </label>

    <label
      id="accessory-status-field"
      class="grid gap-2 text-sm font-bold"
      hidden
    >
      ¿Ya tienes el accesorio?
      <select
        id="accessory-status"
        name="accessoryStatus"
        disabled
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      >
        <option value="" selected disabled>Selecciona una opción</option>
        <option value="Ya tengo el accesorio">Ya tengo el accesorio</option>
        <option value="Quiero consultar disponibilidad limitada">
          Aún no; quiero consultar disponibilidad
        </option>
      </select>
      <span class="font-normal leading-5 text-slate-500 dark:text-slate-400">
        Actualmente no contamos con un catálogo amplio de accesorios en venta.
      </span>
    </label>

    <p
      id="service-fields-placeholder"
      class="text-sm leading-6 text-slate-500 dark:text-slate-400"
    >
      Selecciona un servicio para continuar.
    </p>
  </div>

  <button
    type="submit"
    class="mt-7 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg border border-emerald-800 bg-emerald-700 px-6 py-3 font-bold text-white shadow-[0_4px_0_#065f46,0_10px_22px_rgba(6,78,59,0.2)] transition-[transform,background-color,box-shadow] duration-150 hover:-translate-y-px hover:bg-emerald-600 hover:shadow-[0_5px_0_#065f46,0_13px_26px_rgba(6,78,59,0.24)] focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-3 focus-visible:outline-none active:translate-y-[3px] active:shadow-[0_1px_0_#065f46,0_4px_10px_rgba(6,78,59,0.16)] dark:border-emerald-600 dark:bg-emerald-700 dark:focus-visible:ring-offset-slate-950"
  >
    <MessageCircle aria-hidden="true" class="size-5" stroke-width={2.2} />
    Preparar mensaje en WhatsApp
  </button>

  <p
    id="whatsapp-form-status"
    class="mt-4 text-center text-xs leading-5 text-slate-500 dark:text-slate-400"
    aria-live="polite"
  >
    Este sitio no guarda tus datos. Podrás revisar el mensaje en WhatsApp antes
    de enviarlo.
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "#whatsapp-contact-form",
  );
  const serviceSelect = form?.querySelector<HTMLSelectElement>(
    "#requested-service",
  );
  const mileageField = form?.querySelector<HTMLElement>("#mileage-field");
  const mileageInput = form?.querySelector<HTMLInputElement>(
    "#vehicle-mileage",
  );
  const mileageLabel = form?.querySelector<HTMLElement>("#mileage-label");
  const detailsField = form?.querySelector<HTMLElement>(
    "#service-details-field",
  );
  const detailsInput = form?.querySelector<HTMLTextAreaElement>(
    "#service-details",
  );
  const detailsLabel = form?.querySelector<HTMLElement>(
    "#service-details-label",
  );
  const accessoryStatusField = form?.querySelector<HTMLElement>(
    "#accessory-status-field",
  );
  const accessoryStatus = form?.querySelector<HTMLSelectElement>(
    "#accessory-status",
  );
  const fieldsPlaceholder = form?.querySelector<HTMLElement>(
    "#service-fields-placeholder",
  );
  const status = form?.querySelector<HTMLElement>("#whatsapp-form-status");

  const serviceRules: Record<
    string,
    {
      showMileage?: boolean;
      requireMileage?: boolean;
      detailsLabel?: string;
      detailsPlaceholder?: string;
      showAccessoryStatus?: boolean;
    }
  > = {
    "mecanica-general": {
      showMileage: true,
      requireMileage: true,
      detailsLabel: "¿Qué falla, ruido o comportamiento has notado?",
      detailsPlaceholder:
        "Ej. Escucho un golpe al frenar y el volante vibra desde hace dos días.",
    },
    "electricidad-automotriz": {
      showMileage: true,
      detailsLabel: "¿Qué falla eléctrica o luz del tablero has notado?",
      detailsPlaceholder:
        "Ej. No enciende por la mañana y aparece la luz de batería.",
    },
    "aire-acondicionado": {
      detailsLabel: "¿Qué está haciendo el aire acondicionado?",
      detailsPlaceholder:
        "Ej. Enfría poco, funciona por momentos o produce un olor extraño.",
    },
    "mantenimiento-preventivo": {
      showMileage: true,
      requireMileage: true,
    },
    "instalacion-accesorios": {
      detailsLabel: "¿Qué accesorio deseas instalar?",
      detailsPlaceholder: "Ej. Radio, pantalla, cámara o luces auxiliares.",
      showAccessoryStatus: true,
    },
    otro: {
      detailsLabel: "Describe el problema o servicio que buscas",
      detailsPlaceholder:
        "Cuéntanos qué has notado o qué trabajo deseas consultar.",
    },
  };

  const configureConditionalFields = (clearDetails = false) => {
    if (
      !serviceSelect ||
      !mileageField ||
      !mileageInput ||
      !mileageLabel ||
      !detailsField ||
      !detailsInput ||
      !detailsLabel ||
      !accessoryStatusField ||
      !accessoryStatus ||
      !fieldsPlaceholder
    )
      return;

    const rule = serviceRules[serviceSelect.value];
    const showMileage = Boolean(rule?.showMileage);
    const requireMileage = Boolean(rule?.requireMileage);
    const showDetails = Boolean(rule?.detailsLabel);
    const showAccessoryStatus = Boolean(rule?.showAccessoryStatus);

    fieldsPlaceholder.hidden = Boolean(rule);

    mileageField.hidden = !showMileage;
    mileageInput.disabled = !showMileage;
    mileageInput.required = requireMileage;
    mileageLabel.textContent = requireMileage
      ? "Kilometraje"
      : "Kilometraje (opcional)";

    detailsField.hidden = !showDetails;
    detailsInput.disabled = !showDetails;
    detailsInput.required = showDetails;
    detailsLabel.textContent = rule?.detailsLabel ?? "Detalles del servicio";
    detailsInput.placeholder = rule?.detailsPlaceholder ?? "";

    accessoryStatusField.hidden = !showAccessoryStatus;
    accessoryStatus.disabled = !showAccessoryStatus;
    accessoryStatus.required = showAccessoryStatus;

    if (clearDetails) {
      detailsInput.value = "";
      accessoryStatus.value = "";
    }
  };

  serviceSelect?.addEventListener("change", () =>
    configureConditionalFields(true),
  );
  window.addEventListener("pageshow", () => configureConditionalFields());
  configureConditionalFields();

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!form.reportValidity() || !serviceSelect) return;

    const formData = new FormData(form);
    const value = (field: string) =>
      String(formData.get(field) ?? "").trim();
    const serviceLabel =
      serviceSelect.selectedOptions[0]?.textContent?.trim() ?? value("service");
    const mileage = value("mileage");
    const details = value("details");
    const accessory = value("accessoryStatus");
    const vehicleDetails = [
      `Marca: ${value("brand")}`,
      `Modelo: ${value("model")}`,
      `Año: ${value("year")}`,
    ];

    if (mileage) {
      vehicleDetails.push(
        `Kilometraje: ${Number(mileage).toLocaleString("es-NI")} km`,
      );
    }

    const message = [
      "Hola, quisiera consultar un servicio en Multiservicio Amador.",
      "",
      "*Datos de contacto*",
      `Nombre: ${value("name")}`,
      `Teléfono: ${value("phone")}`,
      "",
      "*Datos del vehículo*",
      ...vehicleDetails,
      "",
      `*Servicio solicitado:* ${serviceLabel}`,
      ...(details ? [`Detalles: ${details}`] : []),
      ...(accessory ? [`Accesorio: ${accessory}`] : []),
    ].join("\n");
    const whatsappNumber = form.dataset.whatsappNumber;
    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
    const link = document.createElement("a");

    link.href = whatsappUrl;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    document.body.append(link);
    link.click();
    link.remove();

    if (status) {
      status.textContent =
        "WhatsApp se abrió con tus datos. Revisa el mensaje antes de enviarlo.";
    }
  });
</script>
