---
import { MessageCircle } from "@lucide/astro";

const whatsappNumber = "50582864467";
const maximumVehicleYear = new Date().getFullYear() + 1;
const serviceOptions = [
  "Mecánica general",
  "Electricidad automotriz",
  "Aire acondicionado",
  "Mantenimiento preventivo",
  "Instalación de accesorios",
  "Otro servicio / diagnóstico",
];
---

<form
  id="whatsapp-contact-form"
  data-whatsapp-number={whatsappNumber}
  class="rounded-xl border border-white/25 bg-white p-5 text-slate-900 shadow-[0_18px_45px_rgba(3,20,55,0.22)] sm:p-7 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:shadow-[0_20px_48px_rgba(0,0,0,0.3)]"
>
  <div class="border-b border-slate-200 pb-5 dark:border-slate-700">
    <h3 class="text-xl font-extrabold tracking-tight sm:text-2xl">
      Datos para la consulta
    </h3>
    <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
      Todos los campos son obligatorios.
    </p>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    <label class="grid gap-2 text-sm font-bold sm:col-span-2">
      Nombre completo
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        minlength="2"
        required
        placeholder="Tu nombre"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold sm:col-span-2">
      Teléfono
      <input
        id="contact-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        minlength="8"
        required
        placeholder="Ej. 8888 8888"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold">
      Marca
      <input
        id="vehicle-brand"
        name="brand"
        type="text"
        required
        placeholder="Ej. Toyota"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold">
      Modelo
      <input
        id="vehicle-model"
        name="model"
        type="text"
        required
        placeholder="Ej. Corolla"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold">
      Año
      <input
        id="vehicle-year"
        name="year"
        type="number"
        inputmode="numeric"
        min="1950"
        max={maximumVehicleYear}
        required
        placeholder="Ej. 2018"
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      />
    </label>

    <label class="grid gap-2 text-sm font-bold">
      Kilometraje
      <span class="relative">
        <input
          id="vehicle-mileage"
          name="mileage"
          type="number"
          inputmode="numeric"
          min="0"
          step="1"
          required
          placeholder="Ej. 85000"
          class="min-h-12 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 pr-12 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] placeholder:text-slate-400 focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
        />
        <span
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-xs font-semibold text-slate-500 dark:text-slate-400"
        >
          km
        </span>
      </span>
    </label>

    <label class="grid gap-2 text-sm font-bold sm:col-span-2">
      Servicio que buscas
      <select
        id="requested-service"
        name="service"
        required
        class="min-h-12 rounded-lg border border-slate-300 bg-white px-4 py-3 font-normal text-slate-900 outline-none transition-[border-color,box-shadow] focus:border-blue-600 focus:ring-3 focus:ring-blue-100 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:focus:border-blue-400 dark:focus:ring-blue-500/15"
      >
        <option value="" selected disabled>Selecciona un servicio</option>
        {serviceOptions.map((service) => <option value={service}>{service}</option>)}
      </select>
    </label>
  </div>

  <button
    type="submit"
    class="mt-7 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg border border-emerald-800 bg-emerald-700 px-6 py-3 font-bold text-white shadow-[0_4px_0_#065f46,0_10px_22px_rgba(6,78,59,0.2)] transition-[transform,background-color,box-shadow] duration-150 hover:-translate-y-px hover:bg-emerald-600 hover:shadow-[0_5px_0_#065f46,0_13px_26px_rgba(6,78,59,0.24)] focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-3 focus-visible:outline-none active:translate-y-[3px] active:shadow-[0_1px_0_#065f46,0_4px_10px_rgba(6,78,59,0.16)] dark:border-emerald-600 dark:bg-emerald-700 dark:focus-visible:ring-offset-slate-950"
  >
    <MessageCircle aria-hidden="true" class="size-5" stroke-width={2.2} />
    Preparar mensaje en WhatsApp
  </button>

  <p
    id="whatsapp-form-status"
    class="mt-4 text-center text-xs leading-5 text-slate-500 dark:text-slate-400"
    aria-live="polite"
  >
    Este sitio no guarda tus datos. Podrás revisar el mensaje en WhatsApp antes
    de enviarlo.
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "#whatsapp-contact-form",
  );
  const status = document.querySelector<HTMLElement>("#whatsapp-form-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const formData = new FormData(form);
    const value = (field: string) =>
      String(formData.get(field) ?? "").trim();
    const mileage = Number(value("mileage")).toLocaleString("es-NI");
    const message = [
      "Hola, quisiera consultar un servicio en Multiservicio Amador.",
      "",
      "*Datos de contacto*",
      `Nombre: ${value("name")}`,
      `Teléfono: ${value("phone")}`,
      "",
      "*Datos del vehículo*",
      `Marca: ${value("brand")}`,
      `Modelo: ${value("model")}`,
      `Año: ${value("year")}`,
      `Kilometraje: ${mileage} km`,
      "",
      `*Servicio solicitado:* ${value("service")}`,
    ].join("\n");
    const whatsappNumber = form.dataset.whatsappNumber;
    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
    const link = document.createElement("a");

    link.href = whatsappUrl;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    document.body.append(link);
    link.click();
    link.remove();

    if (status) {
      status.textContent =
        "WhatsApp se abrió con tus datos. Revisa el mensaje antes de enviarlo.";
    }
  });
</script>
