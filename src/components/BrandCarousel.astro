---
import ford from "../assets/ford.svg";
import honda from "../assets/honda.svg";
import mitsubishi from "../assets/mitsubishi.svg";
import nissan from "../assets/nissan.svg";
import suzuki from "../assets/suzuki.svg";
import toyota from "../assets/toyota.svg";

const brands = [
  { name: "Toyota", logo: toyota },
  { name: "Honda", logo: honda },
  { name: "Nissan", logo: nissan },
  { name: "Mitsubishi", logo: mitsubishi },
  { name: "Suzuki", logo: suzuki },
  { name: "Ford", logo: ford },
];
---

<section
  id="marcas"
  class="relative isolate overflow-hidden border-y border-blue-100/70 bg-gradient-to-b from-white/80 to-blue-50/70 py-16"
  aria-labelledby="brands-title"
>
  <div
    class="absolute -top-24 left-1/4 -z-10 size-72 rounded-full bg-cyan-200/35 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -right-24 -bottom-28 -z-10 size-80 rounded-full bg-blue-200/40 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="mb-3 text-sm font-bold tracking-[0.16em] text-blue-600 uppercase">
          Experiencia multimarca
        </p>
        <h2 id="brands-title" class="text-3xl font-extrabold tracking-tight text-slate-800 sm:text-4xl">
          Marcas que atendemos
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          Estas son algunas de las marcas que recibimos en nuestro taller para
          diagnóstico, mantenimiento y reparación.
        </p>
      </div>

      <button
        class="carousel-toggle motion-reduce:hidden flex w-fit items-center gap-2 rounded-full border border-blue-200/80 bg-white/70 px-4 py-2 text-sm font-bold text-blue-700 shadow-sm backdrop-blur-md transition-colors hover:bg-white focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:outline-none"
        type="button"
        aria-pressed="false"
        aria-label="Pausar carrusel de marcas"
      >
        <span class="carousel-toggle-icon" aria-hidden="true">Ⅱ</span>
        <span class="carousel-toggle-label">Pausar</span>
      </button>
    </div>

    <div class="brand-carousel mt-10 overflow-hidden py-3">
      <div class="brand-track flex w-max">
        {
          [false, true].map((duplicate) => (
            <ul
              class="brand-group flex shrink-0 gap-4 pr-4"
              aria-hidden={duplicate ? "true" : undefined}
            >
              {brands.map((brand) => (
                <li class="group flex h-28 w-40 shrink-0 flex-col items-center justify-center gap-3 rounded-2xl border border-white/80 bg-white/65 px-6 shadow-[0_12px_35px_rgba(30,64,175,0.08)] backdrop-blur-xl transition-[transform,border-color,box-shadow,background-color] duration-300 hover:-translate-y-1 hover:border-blue-200 hover:bg-white/85 hover:shadow-[0_18px_42px_rgba(37,99,235,0.14)] sm:w-44">
                  <img
                    src={brand.logo.src}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                    class="size-12 object-contain opacity-65 transition-[transform,opacity] duration-300 group-hover:scale-105 group-hover:opacity-90"
                  />
                  <span class="text-sm font-bold tracking-wide text-slate-600">
                    {brand.name}
                  </span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .brand-carousel {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .brand-track {
    animation: brand-scroll 28s linear infinite;
  }

  .brand-track.is-paused,
  .brand-carousel:hover .brand-track {
    animation-play-state: paused;
  }

  @keyframes brand-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-carousel {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .brand-track {
      animation: none;
      transform: none;
    }

    .brand-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".carousel-toggle");
  const track = document.querySelector<HTMLElement>(".brand-track");
  const label = toggle?.querySelector<HTMLElement>(".carousel-toggle-label");
  const icon = toggle?.querySelector<HTMLElement>(".carousel-toggle-icon");

  toggle?.addEventListener("click", () => {
    const paused = track?.classList.toggle("is-paused") ?? false;
    toggle.setAttribute("aria-pressed", String(paused));
    toggle.setAttribute(
      "aria-label",
      paused ? "Reanudar carrusel de marcas" : "Pausar carrusel de marcas",
    );
    if (label) label.textContent = paused ? "Reanudar" : "Pausar";
    if (icon) icon.textContent = paused ? "▶" : "Ⅱ";
  });
</script>
