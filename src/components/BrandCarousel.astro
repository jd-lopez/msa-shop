---
import ford from "../assets/ford.svg";
import honda from "../assets/honda.svg";
import mitsubishi from "../assets/mitsubishi.svg";
import nissan from "../assets/nissan.svg";
import suzuki from "../assets/suzuki.svg";
import toyota from "../assets/toyota.svg";

const brands = [
  { name: "Toyota", logo: toyota },
  { name: "Honda", logo: honda },
  { name: "Nissan", logo: nissan },
  { name: "Mitsubishi", logo: mitsubishi },
  { name: "Suzuki", logo: suzuki },
  { name: "Ford", logo: ford },
];
---

<section
  id="marcas"
  class="brand-section relative isolate overflow-hidden border-y border-blue-100/70 bg-linear-to-b from-white/90 to-blue-50/80 py-16 dark:border-slate-800 dark:from-[#070b12] dark:to-slate-900"
  aria-labelledby="brands-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="max-w-2xl">
        <p
          class="mb-3 text-sm font-bold tracking-[0.16em] text-blue-600 uppercase dark:text-blue-300"
        >
          Experiencia multimarca
        </p>
        <h2
          id="brands-title"
          class="text-3xl font-extrabold tracking-tight text-slate-800 dark:text-slate-50 sm:text-4xl"
        >
          Marcas que atendemos
        </h2>
        <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">
          Estas son algunas de las marcas que recibimos en nuestro taller para
          diagnóstico, mantenimiento y reparación.
        </p>
      </div>
    </div>

    <div class="brand-carousel relative mt-10 overflow-hidden py-3">
      <div class="brand-track flex w-max">
        {
          [false, true].map((duplicate) => (
            <ul
              class="brand-group flex shrink-0 gap-4 pr-4"
              aria-hidden={duplicate ? "true" : undefined}
            >
              {brands.map((brand) => (
                <li class="group flex h-28 w-40 shrink-0 flex-col items-center justify-center gap-3 rounded-2xl border border-white bg-white/90 px-6 shadow-[0_12px_35px_rgba(30,64,175,0.08)] transition-[transform,border-color,box-shadow,background-color] duration-300 hover:-translate-y-1 hover:border-blue-200 hover:bg-white hover:shadow-[0_18px_42px_rgba(37,99,235,0.14)] dark:border-slate-700/80 dark:bg-slate-900/85 dark:shadow-[0_12px_38px_rgba(0,0,0,0.3)] dark:hover:border-blue-500/40 dark:hover:bg-slate-800 dark:hover:shadow-[0_18px_44px_rgba(30,64,175,0.16)] sm:w-44">
                  <img
                    src={brand.logo.src}
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                    class="size-12 object-contain opacity-65 transition-[transform,opacity] duration-300 group-hover:scale-105 group-hover:opacity-90 dark:brightness-0 dark:invert"
                  />
                  <span class="text-sm font-bold tracking-wide text-slate-600 dark:text-slate-300">
                    {brand.name}
                  </span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .brand-section {
    content-visibility: auto;
    contain-intrinsic-size: auto 26rem;
  }

  .brand-carousel {
    contain: layout paint;
  }

  .brand-carousel::before,
  .brand-carousel::after {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    width: clamp(2rem, 7vw, 5rem);
    content: "";
    pointer-events: none;
  }

  :global(html.dark) .brand-carousel::before {
    background: linear-gradient(to right, rgb(7 11 18), transparent);
  }

  :global(html.dark) .brand-carousel::after {
    background: linear-gradient(to left, rgb(12 19 31), transparent);
  }

  .brand-carousel::before {
    left: 0;
    background: linear-gradient(to right, rgb(248 251 255), transparent);
  }

  .brand-carousel::after {
    right: 0;
    background: linear-gradient(to left, rgb(244 249 255), transparent);
  }

  .brand-track {
    animation: brand-scroll 28s linear infinite;
  }

  .brand-track.is-paused,
  .brand-carousel:hover .brand-track {
    animation-play-state: paused;
  }

  @keyframes brand-scroll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-carousel {
      overflow-x: auto;
    }

    .brand-carousel::before,
    .brand-carousel::after {
      display: none;
    }

    .brand-track {
      animation: none;
      transform: none;
    }

    .brand-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>

<script>
  const brandSection = document.querySelector<HTMLElement>(".brand-section");
  const brandTrack = brandSection?.querySelector<HTMLElement>(".brand-track");

  if (brandSection && brandTrack && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        brandTrack.classList.toggle("is-paused", !entry.isIntersecting);
      },
      { rootMargin: "150px 0px" },
    );

    observer.observe(brandSection);
  }
</script>
