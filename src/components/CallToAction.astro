---
import { ArrowUpRight, MapPin } from "@lucide/astro";
import ContactForm from "./ContactForm.astro";

const locationUrl =
  "https://www.google.com/maps/place/Multiservicios+Amador/@12.2031314,-86.3925265,747m/data=!3m2!1e3!4b1!4m6!3m5!1s0x8f7151e229a19c21:0xf25ba6bf68966672!8m2!3d12.2031262!4d-86.3879131!16s%2Fg%2F11zd4t9mkw?entry=ttu&g_ep=EgoyMDI2MDgwMi4wIKXMDSoASAFQAw%3D%3D";

const usefulDetails = [
  "Cuándo comenzó la falla",
  "Qué ruido, vibración o luz notaste",
  "En qué momento aparece el problema",
];
---

<section
  id="contacto"
  class="scroll-mt-20 border-t border-blue-400/25 bg-[#0b47b8] px-4 py-16 text-white dark:border-blue-400/15 dark:bg-[#0b1e3a] sm:px-6 lg:px-8 lg:py-20"
  aria-labelledby="cta-title"
>
  <div
    class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,0.78fr)_minmax(34rem,1.22fr)] lg:items-start lg:gap-14"
  >
    <div class="lg:sticky lg:top-28">
      <p
        class="mb-4 text-xs font-bold tracking-[0.18em] text-blue-100 uppercase"
      >
        Solicita una revisión
      </p>
      <h2
        id="cta-title"
        class="max-w-2xl text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl lg:text-5xl"
      >
        Cuéntanos qué vehículo tienes y qué servicio necesitas.
      </h2>
      <p class="mt-5 max-w-xl leading-7 text-blue-100 sm:text-lg">
        Completa los datos y prepararemos un mensaje para WhatsApp. Podrás
        revisarlo antes de enviarlo al taller.
      </p>

      <div class="mt-8 border-t border-blue-200/35 pt-6">
        <p class="text-sm font-bold text-white">Si presenta una falla, recuerda:</p>
        <ul class="mt-4 grid gap-3 text-sm text-blue-100">
          {
            usefulDetails.map((detail, index) => (
              <li class="flex items-start gap-4">
                <span
                  aria-hidden="true"
                  class="mt-0.5 font-mono text-xs font-bold tracking-widest text-blue-200"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{detail}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={locationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-8 inline-flex items-center gap-2 text-sm font-bold text-white underline decoration-blue-200/60 underline-offset-4 transition-colors hover:text-blue-100 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-blue-800 focus-visible:outline-none dark:focus-visible:ring-offset-[#0b1e3a]"
      >
        <MapPin aria-hidden="true" class="size-4" stroke-width={2.2} />
        Ver ubicación del taller
        <ArrowUpRight
          aria-hidden="true"
          class="size-4 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          stroke-width={2.2}
        />
      </a>
    </div>

    <ContactForm />
  </div>
</section>
