---
import { Image } from "astro:assets";
import hero from "../assets/owner-hero.png";

const assurances = [
  "Diagnóstico preciso",
  "Trabajo transparente",
  "Atención puntual",
];
---

<section
  id="inicio"
  class="hero relative isolate scroll-mt-20 overflow-hidden bg-white shadow-md dark:border-b dark:border-blue-400/10 dark:bg-slate-950 dark:shadow-[0_25px_70px_rgba(0,0,0,0.5)]"
>
  <div class="relative z-10 flex flex-col items-center md:flex-row-reverse">
    <div class="relative h-[38rem] w-full shrink-0 md:h-150 md:flex-2 md:p-4">
      <div
        class="absolute inset-0 rounded-2xl bg-linear-20 from-blue-300 from-5% to-gray-400/10 to-40% dark:from-blue-900 dark:to-slate-950/45 md:inset-4"
      >
      </div>
      <Image
        src={hero}
        alt="Técnico de MSA Multiservicio Amador junto a un vehículo en el taller"
        width={960}
        layout="constrained"
        sizes="(min-width: 768px) 40vw, 100vw"
        format="webp"
        quality={75}
        loading="eager"
        fetchpriority="high"
        class="relative z-10 block h-full w-full rounded-bl-2xl rounded-br-2xl object-cover dark:brightness-[0.72] dark:contrast-[1.06] dark:saturate-[0.92] dark:ring-1 dark:ring-blue-300/15 md:rounded-2xl"
      />
      <div class="hero-photo-tone" aria-hidden="true"></div>
    </div>

    <div
      class="hero-copy flex flex-3 flex-col gap-6 px-5 py-10 dark:bg-linear-to-br dark:from-[#070b12] dark:via-blue-950/25 dark:to-slate-900/40 sm:px-8 md:px-10 lg:px-16"
    >
      <div
        class="flex w-fit items-center gap-2 rounded-full border border-blue-200/70 bg-white/85 px-3 py-1.5 text-xs font-bold tracking-[0.14em] text-blue-700 uppercase shadow-sm dark:border-blue-400/25 dark:bg-blue-950/55 dark:text-blue-200"
      >
        <span
          class="size-2 rounded-full bg-cyan-400 shadow-[0_0_10px_#22d3ee] dark:bg-blue-400 dark:shadow-[0_0_10px_#60a5fa]"
        ></span>
        Taller automotriz en Residencial Ciudad El Doral
      </div>

      <h1
        class="max-w-3xl text-4xl leading-[1.08] font-extrabold tracking-tight text-slate-900 dark:text-slate-50 sm:text-5xl lg:text-6xl"
      >
        Mantenimiento confiable para que
        <strong
          class="ml-1 bg-linear-to-r from-blue-700 via-blue-500 to-cyan-500 bg-clip-text text-transparent dark:from-blue-300 dark:via-blue-200 dark:to-slate-100"
        >
          sigas avanzando
        </strong>
      </h1>

      <p
        class="max-w-2xl text-left text-base leading-7 text-slate-600 dark:text-slate-300 sm:text-lg"
      >
        Cuidamos tu vehículo con diagnóstico preciso, trabajo honesto y atención
        cercana. Te explicamos cada recomendación antes de comenzar para que
        vuelvas a la carretera con total tranquilidad.
      </p>

      <div class="flex flex-col gap-3 font-bold sm:flex-row">
        <a
          href="#contacto"
          class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-blue-700 bg-blue-600 px-6 py-3 text-white shadow-[0_4px_0_#1e40af,0_10px_22px_rgba(30,64,175,0.22)] transition-[transform,box-shadow,background-color] duration-150 hover:-translate-y-px hover:bg-blue-500 hover:shadow-[0_5px_0_#1e40af,0_13px_26px_rgba(30,64,175,0.26)] focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-[3px] active:shadow-[0_1px_0_#1e40af,0_4px_10px_rgba(30,64,175,0.18)] dark:border-blue-500/60 dark:bg-blue-700 dark:shadow-[0_4px_0_#172554,0_10px_24px_rgba(0,0,0,0.3)] dark:hover:bg-blue-600 dark:focus-visible:ring-offset-[#070b12] dark:active:shadow-[0_1px_0_#172554,0_4px_10px_rgba(0,0,0,0.24)]"
        >
          Agendar diagnóstico
          <span
            aria-hidden="true"
            class="transition-transform duration-150 group-hover:translate-x-0.5"
            >→</span
          >
        </a>
        <a
          href="#servicios"
          class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-blue-700 shadow-[0_3px_0_#cbd5e1,0_8px_18px_rgba(15,23,42,0.08)] transition-[transform,box-shadow,border-color,background-color] duration-150 hover:-translate-y-px hover:border-blue-300 hover:bg-blue-50 hover:shadow-[0_4px_0_#bfdbfe,0_11px_22px_rgba(30,64,175,0.1)] focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-[2px] active:shadow-[0_1px_0_#cbd5e1,0_3px_8px_rgba(15,23,42,0.08)] dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:shadow-[0_3px_0_#020617,0_8px_18px_rgba(0,0,0,0.24)] dark:hover:border-blue-500/60 dark:hover:bg-slate-700 dark:focus-visible:ring-offset-[#070b12] dark:active:shadow-[0_1px_0_#020617,0_3px_8px_rgba(0,0,0,0.2)]"
        >
          Explorar servicios
          <span
            aria-hidden="true"
            class="transition-transform duration-150 group-hover:translate-y-0.5"
            >↓</span
          >
        </a>
      </div>

      <ul
        class="grid gap-3 pt-2 text-sm font-semibold text-slate-600 dark:text-slate-300 sm:grid-cols-3"
      >
        {
          assurances.map((assurance) => (
            <li class="flex items-center gap-2">
              <span
                aria-hidden="true"
                class="grid size-5 shrink-0 place-items-center rounded-full bg-blue-100 text-xs text-blue-700 dark:bg-blue-500/15 dark:text-blue-300"
              >
                ✓
              </span>
              {assurance}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(circle at 8% 12%, rgb(59 130 246 / 0.2), transparent 28%),
      radial-gradient(
        circle at 42% 92%,
        rgb(34 211 238 / 0.16),
        transparent 30%
      ),
      radial-gradient(
        circle at 92% 5%,
        rgb(167 139 250 / 0.16),
        transparent 26%
      ),
      linear-gradient(115deg, rgb(255 255 255 / 0.94), rgb(239 246 255 / 0.72)),
      white;
  }

  :global(html.dark) .hero {
    background:
      radial-gradient(circle at 4% 10%, rgb(30 64 175 / 0.28), transparent 34%),
      radial-gradient(
        circle at 46% 96%,
        rgb(71 85 105 / 0.16),
        transparent 36%
      ),
      radial-gradient(circle at 96% 2%, rgb(37 99 235 / 0.16), transparent 32%),
      linear-gradient(120deg, rgb(7 11 18), rgb(12 19 31 / 0.98)), rgb(7 11 18);
  }

  .hero-photo-tone {
    position: absolute;
    inset: 0;
    z-index: 20;
    border-radius: 0 0 1rem 1rem;
    background: transparent;
    pointer-events: none;
  }

  :global(html.dark) .hero-photo-tone {
    background:
      radial-gradient(
        circle at 82% 12%,
        rgb(30 64 175 / 0.18),
        transparent 38%
      ),
      radial-gradient(
        circle at 12% 86%,
        rgb(71 85 105 / 0.14),
        transparent 42%
      ),
      linear-gradient(180deg, rgb(7 11 18 / 0.08), rgb(7 11 18 / 0.5));
  }

  @media (min-width: 48rem) {
    .hero-photo-tone {
      inset: 1rem;
      border-radius: 1rem;
    }
  }
</style>
