---
import {
  Wrench,
  Handshake,
  ClockCheck,
  Car,
  MapPinPlusInside,
} from "@lucide/astro";

const whys = [
  {
    icon: Wrench,
    title: "Mantenimiento de calidad",
    description:
      "Cuidamos cada vehículo con atención al detalle para ayudar a prolongar su vida útil y evitar averías inesperadas.",

    featured: true,
  },
  {
    icon: Handshake,
    title: "Honestidad y transparencia",
    description:
      "Te explicamos el estado de tu vehículo y las recomendaciones de mantenimiento de forma clara, sin trabajos innecesarios.",

    featured: false,
  },
  {
    icon: ClockCheck,
    title: "Atención puntual",
    description:
      "Valoramos tu tiempo. Nos esforzamos por brindar un servicio eficiente para que puedas volver a la carretera lo antes posible.",

    featured: false,
  },
  {
    icon: Car,
    title: "Atención personalizada",
    description:
      "Cada automóvil es diferente. Evaluamos las necesidades de tu vehículo para ofrecer el mantenimiento más adecuado.",

    featured: false,
  },
  {
    icon: MapPinPlusInside,
    title: "Compromiso con nuestra comunidad",
    description:
      "Somos un negocio local comprometido con brindar un servicio confiable a las familias y conductores de Mateare y sus alrededores.",

    featured: false,
  },
];
---

<section
  id="nosotros"
  class="why-us relative isolate flex flex-col items-center gap-8 overflow-hidden bg-white/60 px-4 py-16 shadow dark:bg-slate-950/70 dark:shadow-[0_18px_55px_rgba(0,0,0,0.36)]"
>
  <div class="wave-field" aria-hidden="true">
    <svg
      class="glass-wave wave-one"
      viewBox="0 0 1440 280"
      preserveAspectRatio="none"
    >
      <defs>
        <linearGradient id="why-wave-one" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#60a5fa" stop-opacity="0"></stop>
          <stop offset="0.24" stop-color="#2563eb"></stop>
          <stop offset="0.52" stop-color="#06b6d4"></stop>
          <stop offset="0.78" stop-color="#8b5cf6"></stop>
          <stop offset="1" stop-color="#60a5fa" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path
        class="wave-body"
        stroke="url(#why-wave-one)"
        d="M-80 140C160 20 360 260 600 135S1040 10 1520 145"></path>
      <path
        class="wave-shine"
        d="M-80 137C160 17 360 257 600 132S1040 7 1520 142"></path>
      <path
        class="wave-flow"
        stroke="url(#why-wave-one)"
        d="M-80 140C160 20 360 260 600 135S1040 10 1520 145"></path>
    </svg>

    <svg
      class="glass-wave wave-two"
      viewBox="0 0 1440 280"
      preserveAspectRatio="none"
    >
      <defs>
        <linearGradient id="why-wave-two" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#c4b5fd" stop-opacity="0"></stop>
          <stop offset="0.2" stop-color="#7c3aed"></stop>
          <stop offset="0.48" stop-color="#ec4899"></stop>
          <stop offset="0.76" stop-color="#3b82f6"></stop>
          <stop offset="1" stop-color="#c4b5fd" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path
        class="wave-body"
        stroke="url(#why-wave-two)"
        d="M-100 100C140 240 360-20 650 120S1080 230 1540 70"></path>
      <path
        class="wave-shine"
        d="M-100 97C140 237 360-23 650 117S1080 227 1540 67"></path>
    </svg>
  </div>

  <div
    class="relative z-10 flex flex-col items-center gap-4 text-center md:w-1/2"
  >
    <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50">
      Por qué elegir MSA
    </h2>
    <p class="text-slate-600 dark:text-slate-300">
      Nuestro compromiso se refleja en cada diagnóstico, mantenimiento y
      reparación. Explicamos con claridad lo que encontramos antes de comenzar
      el trabajo.
    </p>
  </div>

  <div class="relative z-10 grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      whys.map((card) => {
        const Icon = card.icon;

        return (
          <article
            class={`why-card ${card.featured ? "why-card-featured md:col-span-2" : ""}`}
          >
            <div class="why-icon">
              <Icon />
            </div>
            <div class="why-copy">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .why-us {
    content-visibility: auto;
    contain-intrinsic-size: auto 55rem;
    background:
      radial-gradient(
        circle at 8% 20%,
        rgb(191 219 254 / 0.38),
        transparent 30%
      ),
      radial-gradient(
        circle at 92% 82%,
        rgb(221 214 254 / 0.34),
        transparent 32%
      ),
      radial-gradient(circle at 52% 50%, rgb(165 243 252 / 0.16), transparent 36%),
      rgb(255 255 255 / 0.72);
  }

  .why-card {
    position: relative;
    display: flex;
    min-height: 10rem;
    align-items: stretch;
    gap: 1rem;
    overflow: hidden;
    padding: 1.5rem;

    border: 1px solid rgb(255 255 255 / 0.76);
    border-radius: 1rem;
    background: linear-gradient(
      145deg,
      rgb(255 255 255 / 0.82),
      rgb(248 250 252 / 0.64)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.86),
      0 18px 50px rgb(30 64 175 / 0.1);
    transition:
      transform 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .why-card::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      115deg,
      rgb(255 255 255 / 0.22),
      transparent 38%,
      rgb(96 165 250 / 0.06)
    );
    content: "";
    pointer-events: none;
  }

  .why-card-featured {
    color: rgb(239 246 255);
    border-color: rgb(255 255 255 / 0.54);
    background: linear-gradient(
      135deg,
      rgb(37 99 235 / 0.92),
      rgb(29 78 216 / 0.86) 52%,
      rgb(6 182 212 / 0.78)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.34),
      0 20px 55px rgb(37 99 235 / 0.2);
  }

  .why-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    flex: 0 0 4rem;
    place-items: center;
    align-self: center;
    color: rgb(37 99 235);
    border: 1px solid rgb(255 255 255 / 0.82);
    border-radius: 0.875rem;
    background: linear-gradient(
      145deg,
      rgb(255 255 255 / 0.72),
      rgb(219 234 254 / 0.5)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.86),
      0 9px 24px rgb(37 99 235 / 0.11);
  }

  .why-card-featured .why-icon {
    background: linear-gradient(
      145deg,
      rgb(255 255 255 / 0.9),
      rgb(239 246 255 / 0.72)
    );
    box-shadow:
      inset 0 1px 0 white,
      0 10px 26px rgb(15 23 42 / 0.14);
  }

  .why-icon :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
    stroke-width: 1.65;
  }

  .why-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }

  .why-copy h3 {
    color: rgb(30 41 59);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .why-copy p {
    line-height: 1.65;
  }

  .why-card-featured .why-copy h3 {
    color: white;
  }

  .why-card-featured .why-copy p {
    color: rgb(239 246 255 / 0.92);
  }

  @media (hover: hover) and (pointer: fine) {
    .why-card:hover {
      transform: translateY(-0.25rem);
      border-color: rgb(147 197 253 / 0.8);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.9),
        0 22px 60px rgb(37 99 235 / 0.16);
    }

    .why-card-featured:hover {
      border-color: rgb(255 255 255 / 0.7);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.4),
        0 24px 65px rgb(37 99 235 / 0.25);
    }
  }

  .wave-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .glass-wave {
    position: absolute;
    left: -12%;
    width: 124%;
    height: 17rem;
    overflow: visible;
    color: rgb(37 99 235);
    opacity: 0.58;
    animation: wave-drift 18s ease-in-out infinite alternate;
  }

  .glass-wave path {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .wave-body {
    stroke-width: 10;
    opacity: 0.2;
  }

  .glass-wave .wave-shine {
    stroke: white;
    stroke-width: 1.25;
    opacity: 0.5;
  }

  .wave-flow {
    stroke-width: 2.4;
    stroke-dasharray: 120 720;
    stroke-dashoffset: 0;
    opacity: 0.68;
    animation: light-flow 12s linear infinite;
  }

  .wave-one {
    top: 2%;
  }

  .wave-two {
    top: auto;
    bottom: 2%;
    color: rgb(124 58 237);
    opacity: 0.48;
    animation-duration: 24s;
    animation-delay: -9s;
    animation-direction: alternate-reverse;
  }

  .why-us.animations-paused .glass-wave,
  .why-us.animations-paused .wave-flow {
    animation-play-state: paused;
  }

  :global(html.dark) .why-us {
    background:
      radial-gradient(circle at 7% 16%, rgb(30 64 175 / 0.22), transparent 33%),
      radial-gradient(circle at 92% 84%, rgb(51 65 85 / 0.2), transparent 35%),
      radial-gradient(circle at 52% 48%, rgb(37 99 235 / 0.1), transparent 38%),
      linear-gradient(145deg, rgb(7 11 18 / 0.99), rgb(15 23 35 / 0.95));
  }

  :global(html.dark) .why-card {
    color: rgb(203 213 225);
    border-color: rgb(96 165 250 / 0.16);
    background: linear-gradient(
      145deg,
      rgb(15 23 42 / 0.92),
      rgb(30 41 59 / 0.72)
    );
    box-shadow:
      inset 0 1px 0 rgb(148 163 184 / 0.12),
      0 18px 50px rgb(0 0 0 / 0.3);
  }

  :global(html.dark) .why-card::after {
    background: linear-gradient(
      115deg,
      rgb(96 165 250 / 0.08),
      transparent 42%,
      rgb(59 130 246 / 0.05)
    );
  }

  :global(html.dark) .why-card-featured {
    color: rgb(239 246 255);
    border-color: rgb(96 165 250 / 0.24);
    background: linear-gradient(
      135deg,
      rgb(23 37 84 / 0.96),
      rgb(30 58 138 / 0.9) 54%,
      rgb(51 65 85 / 0.88)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.16),
      0 22px 58px rgb(37 99 235 / 0.22);
  }

  :global(html.dark) .why-icon {
    color: rgb(147 197 253);
    border-color: rgb(96 165 250 / 0.18);
    background: linear-gradient(
      145deg,
      rgb(30 41 59 / 0.92),
      rgb(30 64 175 / 0.34)
    );
    box-shadow:
      inset 0 1px 0 rgb(148 163 184 / 0.14),
      0 9px 25px rgb(0 0 0 / 0.24);
  }

  :global(html.dark) .why-card-featured .why-icon {
    color: rgb(191 219 254);
    border-color: rgb(255 255 255 / 0.18);
    background: linear-gradient(
      145deg,
      rgb(30 41 59 / 0.92),
      rgb(30 64 175 / 0.62)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 10px 28px rgb(2 6 23 / 0.32);
  }

  :global(html.dark) .why-copy h3 {
    color: rgb(241 245 249);
  }

  :global(html.dark) .why-copy p {
    color: rgb(203 213 225);
  }

  :global(html.dark) .why-card-featured .why-copy h3 {
    color: white;
  }

  :global(html.dark) .why-card-featured .why-copy p {
    color: rgb(224 242 254 / 0.94);
  }

  :global(html.dark) .glass-wave {
    opacity: 0.76;
  }

  :global(html.dark) .wave-body {
    opacity: 0.3;
  }

  :global(html.dark) .glass-wave .wave-shine {
    stroke: rgb(148 163 184);
    opacity: 0.36;
  }

  :global(html.dark) .wave-flow {
    opacity: 0.68;
  }

  :global(html.dark) #why-wave-one stop:nth-child(2) {
    stop-color: #315b9c;
  }

  :global(html.dark) #why-wave-one stop:nth-child(3) {
    stop-color: #496f9d;
  }

  :global(html.dark) #why-wave-one stop:nth-child(4) {
    stop-color: #64748b;
  }

  :global(html.dark) #why-wave-two stop:nth-child(2) {
    stop-color: #334155;
  }

  :global(html.dark) #why-wave-two stop:nth-child(3) {
    stop-color: #475569;
  }

  :global(html.dark) #why-wave-two stop:nth-child(4) {
    stop-color: #1e3a8a;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html.dark) .why-card:hover {
      border-color: rgb(96 165 250 / 0.34);
      box-shadow:
        inset 0 1px 0 rgb(148 163 184 / 0.16),
        0 24px 62px rgb(0 0 0 / 0.4);
    }

    :global(html.dark) .why-card-featured:hover {
      border-color: rgb(147 197 253 / 0.42);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.2),
        0 26px 68px rgb(37 99 235 / 0.3);
    }
  }

  @keyframes wave-drift {
    0% {
      transform: translate3d(-3%, 0, 0) rotate(-0.7deg) scaleY(0.92);
    }
    50% {
      transform: translate3d(2%, -1.15rem, 0) rotate(0.55deg) scaleY(1.08);
    }
    100% {
      transform: translate3d(-0.75%, 0.85rem, 0) rotate(-0.3deg) scaleY(0.97);
    }
  }

  @keyframes light-flow {
    to {
      stroke-dashoffset: -840;
    }
  }

  @media (max-width: 47.999rem) {
    .why-card {
      min-height: auto;
      background: linear-gradient(
        145deg,
        rgb(255 255 255 / 0.9),
        rgb(248 250 252 / 0.8)
      );
    }

    .why-card-featured {
      background: linear-gradient(
        135deg,
        rgb(37 99 235 / 0.95),
        rgb(29 78 216 / 0.92) 55%,
        rgb(6 182 212 / 0.86)
      );
    }

    .wave-field {
      opacity: 0.54;
    }

    .glass-wave {
      left: -30%;
      width: 160%;
      height: 12rem;
    }

    .wave-flow {
      stroke-width: 1.8;
      opacity: 0.58;
    }

    .wave-one {
      top: 6%;
    }

    .wave-two {
      display: none;
    }
  }

  @media (max-width: 35rem) {
    .why-card {
      flex-direction: column;
      padding: 1.25rem;
    }

    .why-icon {
      width: 3.5rem;
      height: 3.5rem;
      flex-basis: 3.5rem;
      align-self: flex-start;
    }

    .why-icon :global(svg) {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-wave,
    .wave-flow {
      animation: none;
    }
  }
</style>

<script>
  const whyUs = document.querySelector<HTMLElement>(".why-us");

  if (whyUs && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        whyUs.classList.toggle("animations-paused", !entry.isIntersecting);
      },
      { rootMargin: "150px 0px" },
    );

    observer.observe(whyUs);
  }
</script>
